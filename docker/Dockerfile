# Serving image for the skin-lesion risk API.
#
# Model weights (artifacts/), the MLflow backend (mlflow.db) and run store
# (mlruns/) are all .gitignore'd on purpose (see .gitignore) -- they are
# generated by running the training pipeline, not checked into git. This
# image therefore does NOT bake a model in; it expects artifacts/, mlflow.db
# and mlruns/ to be bind-mounted at run time (see docker-compose.yml, and
# README.md "Running from a clean machine"). That is what lets the registry
# promote/rollback flow (src/registry/) actually change what a running
# container serves, without rebuilding the image.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/ requirements/
RUN pip install --no-cache-dir -r requirements/serving.txt

COPY src/ src/
COPY serving/ serving/
COPY configs/ configs/

ENV PYTHONUNBUFFERED=1 \
    MLFLOW_TRACKING_URI=sqlite:///mlflow.db \
    MLFLOW_DISABLE_AGENT_HINT=1

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request as r; r.urlopen('http://localhost:8000/health', timeout=2)" || exit 1

CMD ["uvicorn", "serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
